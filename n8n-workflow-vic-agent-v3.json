{
  "name": "VTC Agent v3 — Process Call Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/elevenlabs-vic",
        "responseMode": "onReceived",
        "options": {
          "responseData": "{\"status\":\"received\",\"processing\":true}"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook — ElevenLabs",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-160, 300],
      "webhookId": "webhook_vic_agent_v3"
    },
    {
      "parameters": {
        "jsCode": "// ════════════════════════════════════════════════════════════\n// FIRMA HMAC-SHA256 DEL WEBHOOK\n//\n// REGLA DE ORO: la firma y el body enviado deben derivar del MISMO string.\n// Si el nodo HTTP re-serializa el JSON (por ejemplo mandando {{ $json }}),\n// los bytes cambian y el HMAC nunca coincide. Por eso aquí congelamos el\n// body en `rawBody` y el nodo HTTP envía EXACTAMENTE ese string.\n//\n// Requisito de entorno en N8N:\n//   N8N_BLOCK_ENV_ACCESS_IN_NODE=false   (para poder leer $env)\n//   VTC_SHARED_SECRET=<mismo valor que en Vercel>\n// ════════════════════════════════════════════════════════════\nconst crypto = require('crypto');\n\nconst secret = $env.VTC_SHARED_SECRET;\nif (!secret) {\n  throw new Error(\n    'VTC_SHARED_SECRET no está disponible en N8N. ' +\n    'Configúralo en las variables de entorno y asegúrate de que ' +\n    'N8N_BLOCK_ENV_ACCESS_IN_NODE=false.'\n  );\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  // El webhook de N8N entrega el payload en item.json.body; si viene plano,\n  // usamos item.json tal cual.\n  const payload =\n    item.json && item.json.body !== undefined && item.json.body !== null\n      ? item.json.body\n      : item.json;\n\n  // Bytes exactos que se van a transmitir y a firmar.\n  const rawBody = typeof payload === 'string' ? payload : JSON.stringify(payload);\n\n  const timestamp = Math.floor(Date.now() / 1000);\n  const hash = crypto\n    .createHmac('sha256', secret)\n    .update(`${timestamp}.${rawBody}`)\n    .digest('hex');\n\n  out.push({\n    json: {\n      signature: `t=${timestamp},v0=${hash}`,\n      rawBody,\n      body_bytes: Buffer.byteLength(rawBody, 'utf8'),\n      conversation_id:\n        (payload && (payload.conversation_id ||\n          (payload.data && payload.data.conversation_id))) || null,\n      signed_at: new Date(timestamp * 1000).toISOString()\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Firmar HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PUBLIC_BASE_URL }}/api/process-call",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "POST → Process Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-http-200",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "cond-body-success",
              "leftValue": "={{ $json.body.success }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "IF — Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "set-ok-status",
              "name": "status",
              "value": "success",
              "type": "string"
            },
            {
              "id": "set-ok-conv",
              "name": "conversationId",
              "value": "={{ $json.body.conversationId }}",
              "type": "string"
            },
            {
              "id": "set-ok-duration",
              "name": "duration_ms",
              "value": "={{ $json.body.duration }}",
              "type": "number"
            },
            {
              "id": "set-ok-steps",
              "name": "steps",
              "value": "={{ $json.body.steps ? $json.body.steps.length : 0 }}",
              "type": "number"
            },
            {
              "id": "set-ok-ts",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Success Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 190]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "set-err-status",
              "name": "status",
              "value": "error",
              "type": "string"
            },
            {
              "id": "set-err-http",
