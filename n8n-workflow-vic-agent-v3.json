              "type": "string"
            },
            {
              "id": "set-err-conv",
              "name": "conversationId",
              "value": "={{ $json.body ? $json.body.conversationId : null }}",
              "type": "string"
            },
            {
              "id": "set-err-ts",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 410]
    }
