# ════════════════════════════════════════════
# VICTOR IA AGENT v3.0 — Environment Variables
# ════════════════════════════════════════════

# ════ ELEVENLABS ════
ELEVENLABS_API_KEY=sk_your_key_here
ELEVENLABS_AGENT_ID=agent_5701kr0h5gg6eetb69tv6c5hwfj1
ELEVENLABS_VOICE_ID=iDEmt5MnqUotdwCIVplo

# ════ SECURITY ════
# HMAC del webhook post-call (rotado automáticamente cada 90 días)
VTC_SHARED_SECRET=your_hmac_secret_here

# ════ KEY ROTATION (cada 90 días) ════
# Secreto ESTABLE que autentica POST /api/rotate-keys.
# Es distinto de VTC_SHARED_SECRET a propósito: el endpoint rota
# VTC_SHARED_SECRET, así que no puede autenticarse con él.
ROTATION_ADMIN_SECRET=generate_with_crypto_randomBytes_32_hex
ROTATION_INTERVAL_DAYS=90

# Token de Vercel para que el endpoint propague las env vars nuevas.
# Si falta, N8N debe hacer el PATCH (el endpoint devuelve los valores nuevos).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_d3sZH2XWVBRevDDkPRrfVAZegQSl
VERCEL_TEAM_ID=team_W8ML29QI3hNNEdQi5dZVQ771
# Deploy hook para activar las env vars nuevas tras la rotación
VERCEL_DEPLOY_HOOK_URL=

# Protege GET /api/security/rotation-status (opcional; si se omite es público)
ROTATION_STATUS_TOKEN=

# ════ EMAIL ════
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=info@victor-ia.com.mx
EMAIL_TO_PRIMARY=mesainteligentedemo@gmail.com

# ════ VERCEL ════
PUBLIC_BASE_URL=https://victor-ia-agent.vercel.app
ENVIRONMENT=production

# ════ DATABASE (optional) ════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# ════ MONITORING ════
SENTRY_DSN=https://your-sentry-dsn

# ════ FEATURE FLAGS ════
ENABLE_PDF_GENERATION=true
ENABLE_EMAIL_SENDING=true
ENABLE_DATABASE_LOGGING=true
MAX_CALL_DURATION_SECONDS=5400
MAX_FILE_SIZE_MB=50
MAX_DAILY_CALLS=500