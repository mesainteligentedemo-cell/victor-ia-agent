# ════════════════════════════════════════════
# VICTOR IA AGENT v3.0 — Environment Variables
# ════════════════════════════════════════════

# ════ ELEVENLABS ════
ELEVENLABS_API_KEY=sk_your_key_here
ELEVENLABS_AGENT_ID=agent_5701kr0h5gg6eetb69tv6c5hwfj1
ELEVENLABS_VOICE_ID=iDEmt5MnqUotdwCIVplo

# ════ SECURITY ════
# HMAC del webhook post-call (rotado automáticamente cada 90 días).
# OBLIGATORIO: sin este valor, POST /api/process-call responde 401 a todo.
# El mismo valor debe existir en N8N (ver n8n-workflow-vic-agent-v3.json).
VTC_SHARED_SECRET=your_hmac_secret_here

# Firma los enlaces de los CTAs del reporte (/api/pdf/:id, /player, /retrain).
# Recomendado y ESTABLE: si se omite, se usa ROTATION_ADMIN_SECRET y, en último
# término, VTC_SHARED_SECRET — que rota cada 90 días e invalidaría los enlaces
# ya enviados por correo.
REPORT_LINK_SECRET=generate_with_crypto_randomBytes_32_hex
# Vigencia de los enlaces del reporte (por defecto 90 días)
REPORT_LINK_TTL_SECONDS=7776000

# ════ KEY ROTATION (cada 90 días) ════
# Secreto ESTABLE que autentica POST /api/rotate-keys.
# Es distinto de VTC_SHARED_SECRET a propósito: el endpoint rota
# VTC_SHARED_SECRET, así que no puede autenticarse con él.
ROTATION_ADMIN_SECRET=generate_with_crypto_randomBytes_32_hex
ROTATION_INTERVAL_DAYS=90

# Token de Vercel para que el endpoint propague las env vars nuevas.
# Si falta, N8N debe hacer el PATCH (el endpoint devuelve los valores nuevos).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_d3sZH2XWVBRevDDkPRrfVAZegQSl
VERCEL_TEAM_ID=team_W8ML29QI3hNNEdQi5dZVQ771
# Deploy hook para activar las env vars nuevas tras la rotación
VERCEL_DEPLOY_HOOK_URL=

# Protege GET /api/security/rotation-status.
# OBLIGATORIO: si falta, el endpoint responde 503 y no expone nada.
# Uso: Authorization: Bearer <este valor>
ROTATION_STATUS_TOKEN=generate_with_crypto_randomBytes_32_hex

# ════ EMAIL ════
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=info@victor-ia.com.mx
EMAIL_TO_PRIMARY=mesainteligentedemo@gmail.com

# Copias del reporte — campo CC real del correo (visible para todos).
# Acepta varias direcciones separadas por comas. Se omite a quien ya este en
# EMAIL_TO_PRIMARY para que nadie reciba el mismo reporte dos veces.
# Si se deja vacio, el correo sale sin copias.
REPORT_CC=chrisoria16@gmail.com,eldudemateos@gmail.com

# Copias de las solicitudes de reentrenamiento.
# Si se omite, se usan las mismas de REPORT_CC.
RETRAIN_CC=

# ════ SOLICITUDES DE REENTRENAMIENTO ════
# A dónde llegan las solicitudes de /retrain (POST /api/retrain-request).
# Acepta varias direcciones separadas por comas.
# Si se omite, se usa EMAIL_TO_PRIMARY y, en último término, el valor de fábrica
# mesainteligentedemo@gmail.com. Nunca queda vacío: una solicitud sin
# destinatario es una solicitud perdida.
RETRAIN_REQUEST_EMAIL=mesainteligentedemo@gmail.com

# ════ VERCEL ════
PUBLIC_BASE_URL=https://victor-ia-agent.vercel.app
ENVIRONMENT=production

# ════ DATABASE (optional) ════
# Si están definidas, las solicitudes de reentrenamiento se escriben en la
# tabla `retrain_requests` (ver migrations/002_retrain_requests.sql).
# Si faltan, la solicitud se registra en memoria y el correo se envía igual:
# la notificación al gerente nunca depende de la base de datos.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_RETRAIN_TABLE=retrain_requests

# ════ MONITORING ════
SENTRY_DSN=https://your-sentry-dsn

# ════ FEATURE FLAGS ════
ENABLE_PDF_GENERATION=true
ENABLE_EMAIL_SENDING=true
ENABLE_DATABASE_LOGGING=true
MAX_CALL_DURATION_SECONDS=5400
MAX_FILE_SIZE_MB=50
MAX_DAILY_CALLS=500

# ════ PRESUPUESTO DE TIEMPO (lambda de 60s) ════
# La suma de estos techos debe caber en maxDuration (ver vercel.json).
# Por defecto: 55s de pipeline + 5s de margen para responder.
PIPELINE_BUDGET_MS=55000
ELEVENLABS_TIMEOUT_MS=15000
ELEVENLABS_AUDIO_TIMEOUT_MS=15000
EMAIL_TIMEOUT_MS=8000
EMAIL_MAX_RETRIES=1

# ════ CACHÉ DE REPORTES (acelera los CTAs) ════
REPORT_CACHE_TTL_MS=1800000
REPORT_CACHE_MAX_ENTRIES=12
REPORT_CACHE_MAX_BYTES=50331648